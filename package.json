{
  "name": "torrent-indexer",
  "version": "1.2.1",
  "description": "Yet another node.js torrent scraper based on seek-torrent but made especially for movies, series, anime and music (scrape from 1337x, eztv, limetorrents, rarbg, skytorrents, torrentproject, yts and zooqle)",
  "type": "module",
  "main": "src/torrentIndexer.js",
  "scripts": {
    "test": "ava src/lib/*.test.js",
    "test:integration": "ava src/torrentIndexer.test.js src/sources/*.test.js",
    "pretest": "bun run lint",
    "lint": "eslint ."
  },
  "engines": {
    "node": "^22.20.0 || ^24.12.0 || >=26.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sayem314/torrent-indexer.git"
  },
  "funding": {
    "type": "individual",
    "url": "https://github.com/sponsors/sayem314"
  },
  "keywords": [
    "torrent",
    "search",
    "crawler",
    "seek",
    "index",
    "download",
    "movie",
    "series",
    "tracker",
    "tv",
    "show"
  ],
  "author": "Sayem Chowdhury",
  "license": "MIT",
  "dependencies": {
    "axios": "1.16.1",
    "node-html-parser": "7.1.0",
    "parse-torrent-title": "3.0.1",
    "retry-axios": "4.0.3",
    "string-similarity": "4.0.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "ava": "8.0.1",
    "chai": "6.2.2",
    "eslint": "10.4.0"
  },
  "ava": {
    "concurrency": 4,
    "failWithoutAssertions": false,
    "verbose": true,
    "timeout": "30s"
  }
}
